# Copy to .env and edit. Keep it chmod 600 -- it holds your Discord bot token.
# Account credentials are NOT stored here; add them with `icr account add`.

# --- storage --------------------------------------------------------------
# The directory must be writable by the user the service runs as. Back it up
# with `icr db backup` rather than copying the file: in WAL mode a lone copy can
# miss recently committed data.
ICR_DB_PATH=/var/lib/icr/icr.sqlite3

# --- logging --------------------------------------------------------------
ICR_LOG_LEVEL=INFO
ICR_LOG_FILE=/var/log/icr/icr.log
ICR_LOG_MAX_BYTES=10485760
ICR_LOG_BACKUP_COUNT=5

# --- game server pacing ---------------------------------------------------
# Minimum gap between any two game-server requests, applied globally.
ICR_REQUEST_DELAY_SECONDS=2.0
# How many times a transiently-failed code is retried before giving up.
ICR_MAX_REDEEM_ATTEMPTS=3
ICR_HTTP_TIMEOUT_SECONDS=30

# --- scheduling -----------------------------------------------------------
# The only timer. Redemption has none of its own: it runs after a poll that
# leaves work outstanding, and whenever you trigger it (`icr redeem`, or the
# buttons in the web UI). An idle install does nothing and logs nothing.
ICR_SOURCE_POLL_INTERVAL_SECONDS=300

# --- public code lists ----------------------------------------------------
# Community-maintained lists of multi-use codes. No credentials, nothing to set
# up. They overlap with each other and with Discord, which costs nothing -- a
# code already on file is ignored.
ICR_INCENDAR_ENABLED=true
ICR_FANDOM_ENABLED=true

# --- discord source -------------------------------------------------------
# Requires a bot with the Message Content Intent enabled, in the guild that
# follows the Idle Champions #combinations announcement channel.
ICR_DISCORD_ENABLED=false
ICR_DISCORD_BOT_TOKEN=
ICR_DISCORD_MIRROR_CHANNEL_ID=

# --- email source ---------------------------------------------------------
# Reads newsletter codes out of a mailbox. Mailboxes themselves are NOT
# configured here -- each one is tied to a game account and holds a credential,
# so they live in the database: `icr mailbox add`. See docs/email-source.md.
ICR_EMAIL_ENABLED=false
# Comma-separated. Empty scans every message, which turns any 12-character token
# in any newsletter into a redemption attempt -- keep the filter.
ICR_EMAIL_SENDERS=newsletters@codenameentertainment.com
# How far back the first scan of a new mailbox reaches. 0 means all of it.
ICR_EMAIL_INITIAL_SCAN_DAYS=0
# Overlap re-read on each poll; the cursor is a date, so a little slack covers
# mail that arrives out of order. Re-reading is free.
ICR_EMAIL_RESCAN_DAYS=2
ICR_EMAIL_TIMEOUT_SECONDS=60
ICR_EMAIL_MAX_MESSAGES_PER_FOLDER=200
# Only for Microsoft (Outlook/Hotmail/Office 365) mailboxes: your Azure app
# registration. Gmail and other IMAP hosts need none of this.
ICR_EMAIL_OAUTH_CLIENT_ID= # Public by Thunderbird: 9e5f94bc-e8a4-4e73-b8be-63364c29d753
ICR_EMAIL_OAUTH_TENANT=common

# --- web ------------------------------------------------------------------
ICR_WEB_ENABLED=true
ICR_WEB_HOST=127.0.0.1
ICR_WEB_PORT=8787
# Required if ICR_WEB_HOST is not loopback; startup refuses otherwise.
ICR_WEB_AUTH_TOKEN=
# Containers only: allows an unauthenticated bind to 0.0.0.0 when exposure is
# already restricted from outside the process (a port published to loopback).
# Do not set this on a bare-metal host.
ICR_WEB_INSECURE_BIND=false
